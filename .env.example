# Backend Environment Variables (Netlify Functions, Render, Railway, or VPS)
PORT=5000
NODE_ENV=production
# For Production: Use MongoDB Atlas connection string (e.g., mongodb+srv://<user>:<password>@cluster0.mongodb.net/smart_crime_mapping)
MONGODB_URI=mongodb://127.0.0.1:27017/smart_crime_mapping
JWT_SECRET=smart_crime_mapping_super_secure_jwt_secret_key_2026_change_in_prod
JWT_EXPIRES_IN=7d
# Set this to your deployed Netlify frontend URL:
CLIENT_URL=https://your-app-name.netlify.app

# Frontend Environment Variables (Configure in Netlify Site Configuration)
# For standard Netlify unified deployment, leave unset or default to /api for relative rewrites:
VITE_API_URL=/api
